# ==============================================================================
# Railway Deployment Environment Variables Template
# Copy these keys into: Railway Dashboard -> Your Service -> Variables -> Raw Editor
# ==============================================================================

# --- AI & LLM Services (OpenRouter DeepSeek Engine) ---
OPENROUTER_API_KEY=your_openrouter_api_key_here
LLM_MODEL=deepseek/deepseek-chat
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- GitHub Integration (Repository & Portfolio Sync) ---
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_USERNAME=UtkarshSingh-09

# --- Telegram Notifications & Delivery ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# --- Railway Volume & Database Storage ---
# Attach a Railway Volume with mount path: /app/data
DATA_DIR=/app/data
DB_PATH=/app/data/agent.db

# --- Safety & Application Guardrails ---
MAX_DAILY_RESUMES=15
MAX_DAILY_APPLIES=10
MIN_COOLDOWN_SECONDS=180
LOG_LEVEL=INFO
TZ=Asia/Kolkata
