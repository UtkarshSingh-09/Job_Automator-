# ==============================================================================
# Resume Agent Environment Configuration
# Copy this file to .env: cp .env.example .env
# ==============================================================================

# --- AI & LLM Services ---
# Primary: OpenRouter API (Access to DeepSeek V3, Llama 3.3, Claude, etc. at lowest cost)
# Obtain from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
LLM_MODEL=deepseek/deepseek-chat
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional Direct Provider: Anthropic API Key
# Obtain from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- GitHub Integration ---
# Required from Phase 3: Fine-Grained Personal Access Token (Read-only contents/metadata)
# Obtain from: https://github.com/settings/tokens?type=beta
GITHUB_TOKEN=your_github_pat_token_here
GITHUB_USERNAME=UtkarshSingh-09

# --- Telegram Notifications & Delivery ---
# Required from Phase 9: Telegram Bot Token and Chat ID
# Create bot via https://t.me/BotFather, get chat ID via https://t.me/userinfobot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_numeric_chat_id_here

# --- Optional Aggregators ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- System & Safety Guardrails ---
DB_PATH=data/agent.db
MAX_DAILY_RESUMES=15
MAX_DAILY_APPLIES=10
MIN_COOLDOWN_SECONDS=180
LOG_LEVEL=INFO
